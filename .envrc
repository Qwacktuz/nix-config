#!/usr/bin/env bash

# nix-direnv is provided by home-manager (modules/features/direnv.nix).
watch_file flake.nix
watch_file flake.lock

# Watch directories too, so adding or removing modules invalidates the cache.
while IFS= read -r -d '' path; do
  watch_file "$path"
done < <(find modules checks \( -type d -o -name '*.nix' \) -print0)

mkdir -p "$PWD/.devenv"
DEVENV_ROOT_FILE="$PWD/.devenv/root"
printf %s "$PWD" >"$DEVENV_ROOT_FILE"
if ! use flake . --override-input devenv-root "file+file://$DEVENV_ROOT_FILE"; then
  echo "devenv could not be built. Fix the flake configuration and run direnv reload." >&2
  return 1
fi
