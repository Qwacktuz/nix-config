From 3c2ae037013e840046ed9785c4da82aa1c628872 Mon Sep 17 00:00:00 2001
From: Malix - Alix Brunet <alixbrunetcontact@gmail.com>
Date: Sat, 3 Oct 2026 17:48:45 +0200
Subject: [PATCH 1/2] fix(json): handle unknown activity types gracefully

---
 nix-output-monitor/lib/NOM/NixMessage/JSON.hs | 1 +
 nix-output-monitor/lib/NOM/Parser/JSON.hs     | 3 ++-
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/lib/NOM/NixMessage/JSON.hs b/lib/NOM/NixMessage/JSON.hs
index 4153fbba..e1ed6bb3 100644
--- a/lib/NOM/NixMessage/JSON.hs
+++ b/lib/NOM/NixMessage/JSON.hs
@@ -40,6 +40,7 @@ data ActivityType where
   PostBuildHookType :: ActivityType
   BuildWaitingType :: ActivityType
   FetchTreeType :: ActivityType
+  OtherType :: Int -> ActivityType
   deriving stock (Show, Eq)
 
 -- | nix src/libutil/include/nix/util/logging.hh ActivityType
diff --git a/lib/NOM/Parser/JSON.hs b/lib/NOM/Parser/JSON.hs
index 79e3a8b3..f51bd90e 100644
--- a/lib/NOM/Parser/JSON.hs
+++ b/lib/NOM/Parser/JSON.hs
@@ -45,7 +45,7 @@ parseActivityType = \case
   110 -> pure PostBuildHookType
   111 -> pure BuildWaitingType
   112 -> pure FetchTreeType
-  other -> fail ("invalid activity type: " <> show other)
+  other -> pure (OtherType other)
 
 parseAction :: JSON.Decoder NixJSONMessage
 parseAction = JSON.object $ do
@@ -136,6 +136,7 @@ parseStartAction = do
   let txt = textFields
   activity <- case activityType of
     UnknownType -> pure Unknown
+    OtherType _ -> pure Unknown
     CopyPathType ->
       three txt >>= \(path, from, to) -> do
         path' <- parseStorePath path

From 202f940f96360548dedfb3b9234f6f6f08a9a2ba Mon Sep 17 00:00:00 2001
From: Malix - Alix Brunet <alixbrunetcontact@gmail.com>
Date: Sat, 10 Oct 2026 15:11:58 +0200
Subject: [PATCH 2/2] fix(json): handle unknown activity result types
 gracefully

---
 nix-output-monitor/lib/NOM/NixMessage/JSON.hs | 1 +
 nix-output-monitor/lib/NOM/Parser/JSON.hs     | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/lib/NOM/NixMessage/JSON.hs b/lib/NOM/NixMessage/JSON.hs
index e1ed6bb3..fb99ae48 100644
--- a/lib/NOM/NixMessage/JSON.hs
+++ b/lib/NOM/NixMessage/JSON.hs
@@ -72,6 +72,7 @@ data ActivityResult where
   SetExpected :: ActivityType -> Int -> ActivityResult
   PostBuildLogLine :: Text -> ActivityResult
   FetchStatus :: Text -> ActivityResult
+  OtherResult :: Int -> ActivityResult
   deriving stock (Show, Eq)
 
 data ActivityProgress = MkActivityProgress
diff --git a/lib/NOM/Parser/JSON.hs b/lib/NOM/Parser/JSON.hs
index f51bd90e..62bffbfd 100644
--- a/lib/NOM/Parser/JSON.hs
+++ b/lib/NOM/Parser/JSON.hs
@@ -121,7 +121,7 @@ parseResultAction = do
       pure $ SetExpected activityType number
     107 -> PostBuildLogLine <$> one txt
     108 -> FetchStatus <$> one txt
-    other -> fail ("invalid activity result type: " <> show other)
+    other -> pure (OtherResult other)
   pure MkResultAction{id = idField, result}
 
 parseStopAction :: JSON.FieldsDecoder StopAction
