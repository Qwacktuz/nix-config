{ lib, ... }:
{
  # see https://github.com/NixOS/nixpkgs/issues/493775#issuecomment-3969526444
  flake.overlays.patches = final: prev: {
    yt-dlp = prev.yt-dlp.overridePythonAttrs (oldAttrs: {
      dependencies = lib.filter (
        dep:
        !(lib.elem dep.pname [
          "cffi"
          "secretstorage"
        ])
      ) oldAttrs.dependencies;
    });
  };

  # flake.overlays.patches = final: prev: {
  #   yt-dlp = prev.yt-dlp.overridePythonAttrs (oldAttrs: {
  #     # don't use gnome keyring
  #     dependencies = (
  #       __filter (
  #         prev:
  #         !(__elem prev.pname [
  #           "cffi"
  #           "secretstorage"
  #         ])
  #       ) oldAttrs.dependencies
  #     );
  #   });
  # };
}
