{
  flake.modules.homeManager.ghostty =
    { lib, pkgs, ... }:
    let
      inherit (builtins) isBool isFloat isInt;
      inherit (lib)
        concatStringsSep
        mapAttrsToList
        optionalAttrs
        optionals
        ;

      renderValue =
        value:
        if isBool value then
          lib.boolToString value
        else if isInt value || isFloat value then
          toString value
        else
          value;

      renderSettingLines =
        settings: mapAttrsToList (name: value: "${name} = ${renderValue value}") settings;

      commonSettings = {
        "background-blur" = true;
        "background-opacity" = "0.7";
        "clipboard-paste-bracketed-safe" = true;
        "clipboard-paste-protection" = true;
        "clipboard-trim-trailing-spaces" = true;
        "cursor-color" = "#F28FAD";
        "cursor-opacity" = "0.8";
        "font-family" = "JetBrainsMono Nerd Font";
        "font-size" = 14;
        "maximize" = true;
        "mouse-hide-while-typing" = true;
        "shell-integration-features" = "cursor,sudo,title,ssh-env,ssh-terminfo,path";
        "theme" = "Catppuccin Mocha";
        "title-report" = false;
        "window-decoration" = true;
        "window-padding-x" = 8;
        "window-title-font-family" = "JetBrainsMono Nerd Font";
      };

      darwinSettings = {
        "auto-update" = "off";
        "macos-auto-secure-input" = true;
        "macos-icon" = "blueprint";
        "macos-non-native-fullscreen" = true;
        "macos-option-as-alt" = true;
        "macos-secure-input-indication" = true;
        "macos-titlebar-proxy-icon" = "hidden";
        "macos-titlebar-style" = "hidden";
        "macos-window-shadow" = false;
        "quick-terminal-screen" = "main";
        "window-vsync" = true;
      };

      darwinKeybinds = [
        "global:cmd+/=toggle_quick_terminal"
        "alt+a=text:å"
        "alt+'=text:æ"
        "alt+o=text:ø"
        "alt+shift+a=text:Å"
        "alt+shift+'=text:Æ"
        "alt+shift+o=text:Ø"
      ];

      settings = commonSettings // optionalAttrs pkgs.stdenvNoCC.isDarwin darwinSettings;
      keybinds = optionals pkgs.stdenvNoCC.isDarwin darwinKeybinds;

      configText =
        concatStringsSep "\n" (
          [ "# Generated by Home Manager." ]
          ++ builtins.map (keybind: "keybind = ${keybind}") keybinds
          ++ [ "" ]
          ++ renderSettingLines settings
        )
        + "\n";
    in
    {
      home.packages = optionals (pkgs.stdenvNoCC.isLinux && pkgs ? ghostty) [ pkgs.ghostty ];

      xdg.configFile."ghostty/config" = {
        text = configText;
      };

      home.file."Library/Application Support/com.mitchellh.ghostty/config" =
        lib.mkIf pkgs.stdenvNoCC.isDarwin
          {
            text = configText;
          };
    };
}
